FROM python:3.13-slim

WORKDIR /app

# Copy requirements first for better layer caching
COPY requirements-relay.txt .

# Install dependencies
RUN pip install --no-cache-dir -r requirements-relay.txt

# Create data directory for chat history
RUN mkdir -p /app/data

# Copy source code
COPY server-relay.py .

# Expose port for relay server
EXPOSE 5000

# Set environment variables
ENV PYTHONUNBUFFERED=1

# Command to run the relay server
CMD ["python", "server-relay.py"]